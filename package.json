{
  "name": "opennextjs-azion",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "catalog:",
    "pkg-pr-new": "^0.0.80",
    "prettier": "3.3.3"
  },
  "scripts": {
    "fix": "pnpm prettier:fix && pnpm lint:fix",
    "build": "pnpm --filter @aziontech/opennextjs-azion build",
    "test": "pnpm -r test",
    "e2e": "pnpm build && pnpm -r e2e",
    "e2e:dev": "pnpm build && pnpm -r e2e:dev",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint:check": "pnpm -r lint:check",
    "lint:fix": "pnpm -r lint:fix",
    "ts:check": "pnpm -r ts:check",
    "code:checks": "pnpm prettier:check && pnpm lint:check && pnpm ts:check",
    "install-playwright": "playwright install --with-deps",
    "postinstall": "pnpm --filter @aziontech/opennextjs-azion build"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "sharp@^0.34.3": ">=0.35.0 <0.36.0",
      "postcss": ">=8.5.18 <9.0.0",
      "brace-expansion@^2.0.0": ">=2.1.7 <3.0.0",
      "brace-expansion@^5.0.0": ">=5.0.12 <6.0.0",
      "js-yaml@^3.0.0": ">=3.15.2 <4.0.0",
      "js-yaml@^4.0.0": ">=4.3.2 <5.0.0",
      "qs@^6.14.0": ">=6.16.0 <7.0.0",
      "@humanfs/node": ">=0.16.8 <0.17.0"
    }
  }
}
